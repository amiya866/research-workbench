026-10-08",-23.0],["2026-10-09",-23.91]],"annotations":[{"date":"2025-01-20","text":"就职日：边境与能源紧急状态，启动退出 WHO / 巴黎协定"},{"date":"2025-02-01","text":"对加拿大、墨西哥和中国进口加征关税"},{"date":"2025-03-20","text":"推动教育权力回归州、家庭和社区"},{"date":"2025-04-02","text":"宣布全球对等关税框架"},{"date":"2025-06-22","text":"Operation Midnight Hammer 打击伊朗核设施"},{"date":"2025-07-04","text":"One Big Beautiful Bill Act 签署成法"},{"date":"2025-07-23","text":"发布 America’s AI Action Plan，并推动 AI 出口与数据中心建设"},{"date":"2025-08-11","text":"宣布华盛顿特区治安紧急状态"},{"date":"2026-01-03","text":"美国对委内瑞拉发动军事行动并拘押马杜罗"},{"date":"2026-01-07","text":"指示退出 66 个国际组织、协定或条约机制"},{"date":"2026-02-27","text":"美以伊冲突爆发，Operation Epic Fury 开始"}]},"taco_events":[{"end":"2026-08-18","range":"2026-07-20 → 2026-08-18","strength":"强","title":"加拿大关税/贸易谈判","threat":"7月20日，特朗普援引《1930年关税法》第338条，宣布对约200亿美元加拿大商品额外征收50%关税，原定8月19日凌晨生效；该措施覆盖汽车、酒类、乳制品等，并突破了部分USMCA免税安排。","retreat":"8月18日晚、距离生效不到两小时，特朗普宣布把50%关税暂停三天，称美加已经达成一项仍待文件定稿的协议，为继续谈判留出时间。","reason":"从已签署公告、设定明确生效时点的高强度关税措施，在最后一刻改为短期暂停并转回谈判，是典型的最后期限回撤型TACO；但暂停仅三天，协议细节尚未公布，并非永久撤销。","implication":"短期避免北美贸易冲突立即升级，缓释加拿大出口商、美国进口商和通胀预期压力；但三天窗口很短，若协议未落地，关税与报复措施风险会迅速回归。"},{"end":"2026-08-17","range":"2026-06-17 → 2026-08-17","strength":"中","title":"伊朗战争/和平协议期限","threat":"6月17日，特朗普签署的美伊备忘录设定60天目标，要求在期限内结束战争并达成核协议，把明确倒计时作为推动伊朗让步的施压工具。","retreat":"60天期限届满且双方分歧仍在扩大时，特朗普称该期限“无关紧要”、谈判没有时间表；美方同时仍保留与伊朗的后门沟通渠道。","reason":"从公开设定60天硬期限，回撤为期限不重要且不再设时间表，属于最后期限失效后的口径降级型TACO；但战争、封锁和军事威胁并未因此解除。","implication":"降低期限届满即自动升级的即时风险，却延长了战争、核谈判与霍尔木兹航运的不确定期；市场面对的是尾部风险后移，而非持久和平。"},{"end":"2026-08-09","range":"2026-08-01/02 → 2026-08-09","strength":"强","title":"伊朗战争/军事升级","threat":"7月底至8月初，特朗普政府在对伊谈判受阻后准备扩大军事行动，曾接近下令对伊朗能源和基础设施发动大规模攻击。","retreat":"8月2日，特朗普取消拟议攻击并为谈判留出空间；8月9日又称美国正对伊朗“低调处理”，转而依靠有限外交、制裁和经济压力，而非立即恢复大规模作战。","reason":"从接近升级到大规模军事打击，回撤为取消攻击并把主要压力工具降为谈判与经济手段，构成清晰的军事升级—降级闭环；但海上封锁和军事选项仍保留，并非全面撤压。","implication":"短期降低美伊全面战争及能源设施遇袭的尾部风险，但霍尔木兹航运、油价和制裁风险仍高，市场应把它视为战术性降级而非持久停火。"},{"end":"2026-07-14","range":"2026-07-13 → 2026-07-14","strength":"强","title":"霍尔木兹海峡航运收费","threat":"7月13日，特朗普在重启对伊朗海上封锁之际宣布，美国将对所有通过霍尔木兹海峡的货物收取20%的“补偿费”，以支付航道安保成本。","retreat":"7月14日，特朗普撤回20%收费方案，称在与中东领导人沟通后，将改由海湾国家对美贸易和投资安排取代该费用，并表示不应有人对海峡通行收费。","reason":"高冲击、法律与盟友阻力明显的航运收费威胁在一天内被取消，改写为尚待落实的投资交易，是典型的快速政策回撤型TACO；但对伊朗的军事封锁与打击并未同步撤回。","implication":"直接缓解了全球航运、油气与保险成本再叠加20%费用的风险，油价在消息后回吐部分涨幅；但海峡交火和封锁仍使能源供应风险溢价维持高位。"},{"end":"2026-06-11","range":"2026-06-11","strength":"强","title":"伊朗战争/停火谈判","threat":"6月11日，特朗普威胁当晚将“VERY HARD”打击伊朗，并放话美国将对伊朗油气产业实施“完全控制”，包括继续以关键出口与能源设施为施压对象。","retreat":"数小时后，特朗普又称因与伊朗高层接触取得进展，已叫停新一轮对伊打击，并宣称延长停火、推进协议的安排接近达成；但伊朗方面随后表示谈判虽有进展，仍无最终决定。","reason":"这是典型的同日军事升级型TACO：先把威胁抬到“当晚重击+控制油气命脉”，随后迅速切回“暂停打击、等待协议”，把全面升级重新改写为谈判筹码。","implication":"短线缓解油价与全球风险资产对霍尔木兹供给中断的恐慌定价，但也强化了市场对特朗普在伊朗议题上“极限施压后快速降温”的交易预期，意味着地缘风险溢价未来仍可能高频来回摆动。"},{"end":"2026-05-27","range":"2026-05-23 → 2026-05-27","strength":"中","title":"伊朗战争/停火谈判","threat":"5月23日，特朗普宣称与伊朗结束战争、并恢复霍尔木兹航运的协议已“基本谈妥/大体谈成”，并称“细节将很快宣布”。","retreat":"5月27日，特朗普在内阁会议上称伊朗“很想达成协议”，但美国“还不满意”，并淡化短期内达成最终协议的预期。","reason":"从“协议很快宣布”的高调口径回撤到“仍不满意、仍在拉扯”的更谨慎表述，属于对外施压—市场预期管理型TACO。","implication":"能源与航运风险溢价短期更难彻底出清；市场对“先放话、后降温”的伊朗议题TACO定价可能强化。"},{"end":"2026-05-24","range":"2026-05-23/24","strength":"中","title":"伊朗战争/停火谈判","threat":"特朗普先释放“和平备忘录/协议已大体谈成、将很快宣布”的信号，抬升外界对快速停火与开放霍尔木兹的期待。","retreat":"随后特朗普称已要求谈判代表“不要急于达成协议”，并表示美国封锁/施压措施仍维持，给“即将突破”的叙事降温。","reason":"从“很快宣布”转为“别急、时间在我方”，把临门一脚的预期回撤为拉长谈判时间表。","implication":"缓和了对即时停火的确定性押注；油价与航运供给的尾部风险被延后而非消除。"},{"end":"2026-05-22","range":"2026-05-22","strength":"中","title":"半导体关税/产业政策","threat":"在特朗普政府持续释放对关键产业加征关税的信号下，市场担忧“芯片关税”可能在短期落地、冲击科技链与通胀预期。","retreat":"美国贸易代表Jamieson Greer表示没有“立即”的芯片关税，并强调若采取保护措施也要把握“时点和幅度”。","reason":"从“随时可能加码”的市场预期，回撤到“不会立刻、可控时点/幅度”的口径，典型政策时点降级型TACO。","implication":"短期缓释科技硬件与半导体供应链的关税冲击预期，但保留后续加税的政策选项与不确定性。"},{"end":"2026-05-21","range":"2026-05-21","strength":"中","title":"AI监管/网络安全行政令","threat":"白宫原计划举行签署仪式，特朗普将签署新的AI与网络安全行政令（被外界视为对前沿模型更强监管的信号）。","retreat":"签署仪式被推迟/取消，特朗普称他不喜欢部分内容，担心影响美国在AI竞争中的优势。","reason":"从“即将签署的监管加码”临门撤回到“先推迟再改”，属于监管口径后撤型TACO。","implication":"减轻了短期AI合规与监管不确定性，但也意味着政策可能以更不透明方式改写、增加后续突发性风险。"},{"end":"2026-05-18","range":"2026-05-18","strength":"强","title":"美伊军事打击","threat":"特朗普称原定次日对伊朗发动打击，并要求军方保持大规模打击准备。","retreat":"伊朗经巴基斯坦提交新和平方案后，特朗普暂停原定袭击，并称有机会达成限制伊核协议。","reason":"第二轮美伊军事TACO：从轰炸窗口转回谈判窗口。","implication":"油价因袭击暂停而回落；但特朗普保留随时重启大规模攻击的威胁。"},{"end":"2026-05-16","range":"2026-05-14/16","strength":"中","title":"中美北京峰会","threat":"访华前，中美仍处于高关税、出口管制、农业和航空采购摩擦背景下。","retreat":"访华后，中方称关税、农业、飞机协议仍是初步成果，双方将设贸易和投资机制谈产品级关税削减。","reason":"弱TACO：不是突然撤回，而是从系统性对抗转向清单式谈判。","implication":"中美关系进入篮子式成果清单阶段，但细节、规模、时间表仍不确定。"},{"end":"2026-05-08","range":"2026-05-07/08","strength":"中强","title":"欧盟汽车与贸易协议执行","threat":"特朗普称欧盟未履行2025年协议，威胁把欧盟汽车关税从15%提高到25%。","retreat":"随后给欧盟至7月4日履约期限，而非立即执行更高关税。","reason":"立即加税变成新最后期限。","implication":"延续对欧TACO模式：用加税威胁换取执行谈判。"},{"end":"2026-05-07","range":"2026-05-07","strength":"强","title":"美伊停火压力测试","threat":"美伊在霍尔木兹附近交火，是一个月停火以来最严重考验。","retreat":"特朗普仍称停火有效，美国也称不寻求升级。","reason":"交火后仍压住全面升级，属于停火维护型TACO。","implication":"市场需要继续给油价和通胀风险定价，但白宫暂时不愿重启全面战争。"},{"end":"2026-04-08","range":"2026-04-08之后","strength":"中强","title":"美伊停火后谈判","threat":"停火后，美国、伊朗对核问题、黎巴嫩、霍尔木兹等议题分歧仍大。","retreat":"两周停火下开启谈判，但双方对停火范围和核安排解释不同。","reason":"TACO后的典型状态：不是解决问题，而是把全面升级推迟。","implication":"风险从立即战争转为脆弱停火和谈判破裂风险。"},{"end":"2026-04-08","range":"2026-04-07/08","strength":"最强","title":"美伊战争 / 霍尔木兹海峡","threat":"特朗普给伊朗设最后期限，要求重开霍尔木兹海峡，否则面临对民用基础设施的毁灭性打击。","retreat":"在最后期限前不到两小时，特朗普宣布由巴基斯坦斡旋的两周停火。","reason":"军事打击威胁转为短暂停火。","implication":"地缘版TACO：油价从战争溢价中回落，但伊朗仍掌握霍尔木兹杠杆。"},{"end":"2026-01-21","range":"2026-01-17 → 2026-01-21","strength":"强","title":"格陵兰 / 北约盟友关税","threat":"特朗普威胁对8个欧洲国家征收递增关税，以施压格陵兰议题。","retreat":"随后在达沃斯期间撤回关税威胁，称不会在下月征收相关关税，并称已有框架。","reason":"地缘加关税版TACO。","implication":"对北约盟友的极限施压最终被降级，避免欧美贸易和安全关系同步恶化。"},{"end":"2025-08-12","range":"2025-08-12","strength":"强","title":"中美关税休战续期","threat":"中美90天休战若到期，关税可能重新跳升至美国145%、中国125%。","retreat":"双方再延长90天，维持美国对中国30%、中国对美国10%。","reason":"极端关税被继